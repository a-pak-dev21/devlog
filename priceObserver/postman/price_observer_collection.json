          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "})",
                  "",
                  "pm.test(\"Response is JSON object\", function () {",
                  "    pm.response.to.be.json;",
                  "})",
                  "",
                  "pm.test(\"Response include snapshot id\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"snapshot_id\")",
                  "})",
                  "",
                  "const snapshotId = pm.response.json()[\"snapshot_id\"]",
                  "",
                  "pm.collectionVariables.set(\"lastSnapshotId\", snapshotId)",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
